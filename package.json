{
  "name": "rulesync-deploy",
  "version": "0.1.2",
  "description": "Deploy Rulesync projects to all agents installed on your machine.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisfls/rulesync-deploy.git"
  },
  "homepage": "https://github.com/chrisfls/rulesync-deploy#readme",
  "bugs": {
    "url": "https://github.com/chrisfls/rulesync-deploy/issues"
  },
  "license": "MIT",
  "files": [
    "bin/",
    "dist/cli.mjs",
    "dist/deploy.mjs",
    "dist/targets.mjs"
  ],
  "bin": {
    "rulesync-deploy": "bin/rulesync-deploy.mjs"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "deploy": "node src/cli.mts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "test": "node --test \"src/*.test.mts\"",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm run build && npm test && openspec validate --all --strict"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "rulesync": "43.10.0"
  },
  "devDependencies": {
    "@fission-ai/openspec": "2.1.1",
    "@types/node": "24.10.0",
    "typescript": "7.0.2"
  }
}
