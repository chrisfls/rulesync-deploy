{
  "name": "rulesync-deploy",
  "version": "0.1.0",
  "description": "Detect installed AI coding agents and deploy a Rulesync project to them",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisfls/rulesync-deploy.git"
  },
  "homepage": "https://github.com/chrisfls/rulesync-deploy#readme",
  "bugs": {
    "url": "https://github.com/chrisfls/rulesync-deploy/issues"
  },
  "license": "MIT",
  "files": [
    "bin/",
    "src/cli.mts",
    "src/deploy.mts",
    "src/targets.mts"
  ],
  "bin": {
    "rulesync-deploy": "./bin/rulesync-deploy.mjs"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "deploy": "node src/cli.mts",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check": "npm run typecheck && npm test && openspec validate --all --strict"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "rulesync": "43.10.0"
  },
  "devDependencies": {
    "@fission-ai/openspec": "2.1.1",
    "@types/node": "24.10.0",
    "typescript": "7.0.2"
  }
}
